{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "outDir": "./node_modules/.tsbuild/node"
  },
  "include": [
    "electron.vite.config.ts",
    "vite.demo.config.ts",
    "vite.web.config.ts",
    "vite.web-host.config.ts",
    "vitest.config.mts",
    "playwright.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "tests/unit/**/*.ts",
    "scripts/**/*.d.mts"
  ]
}
